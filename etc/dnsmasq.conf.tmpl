# PirateBox DHCP + DNS. Rendered by install.sh -> /etc/piratebox/dnsmasq.conf
# Runs as its own instance (piratebox-dnsmasq.service), not the system dnsmasq.
interface=@IFACE@
bind-interfaces
except-interface=lo
no-resolv
no-hosts
no-poll
# Never forward: answer every name with the box itself. This is what makes
# typing any http:// address land on the portal.
address=/#/@IP@
# Give the portal its proper name too (harmless duplicate of the wildcard).
address=/@HOSTNAME@/@IP@
dhcp-range=@DHCP_START@,@DHCP_END@,255.255.255.0,2h
dhcp-option=option:router,@IP@
dhcp-option=option:dns-server,@IP@
# RFC 8910 captive-portal API URL. Newer phones use it to find the portal.
dhcp-option=114,http://@HOSTNAME@/
dhcp-authoritative
dhcp-leasefile=/var/lib/piratebox/dnsmasq.leases
log-facility=-
quiet-dhcp
