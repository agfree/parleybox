[Unit]
Description=PirateBox Wi-Fi interface (static address)
PartOf=piratebox.target
After=network-pre.target sys-subsystem-net-devices-wlan0.device
Before=piratebox-hostapd.service piratebox-dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/piratebox/piratebox-net up
ExecStop=/usr/local/lib/piratebox/piratebox-net down

[Install]
WantedBy=piratebox.target
